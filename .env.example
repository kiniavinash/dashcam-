# HuggingFace token — required for gated models (nvidia/Alpamayo-R1-10B)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the model license at: https://huggingface.co/nvidia/Alpamayo-R1-10B
HF_TOKEN=hf_your_token_here
